# Mock backend is enabled by default in dev/demo. Set to false to point to a real backend.
VITE_ENABLE_MOCKS=true

# Base URL for the (mocked) REST API.
VITE_API_BASE_URL=/api

# Base URL for the (mocked) Socket.IO server. Accepts absolute or relative.
VITE_SOCKET_URL=/socket.io

# Behavior profile consumed by MSW handlers: 'standard' | 'slow' | 'flaky' | 'offline'
VITE_NETWORK_PROFILE=standard


# When deploying to Vercel, set VITE_ENABLE_MOCKS=true at build time so MSW is bundled.
# See vercel.json — the demo build enables mocks for preview/production.